---
// Kaviku - открытый исходный код / open source (AGPL-3.0)
// Сайт: https://kaviku.pages.dev
// GitHub: https://github.com/Kaviku-Group/Kaviku
// SPDX-License-Identifier: AGPL-3.0-only

import SubmitGameButton from './SubmitGameButton.astro';
import PublicationRulesModal from './PublicationRulesModal.astro';
import Icon from './Icon.astro';
import { siteConfig } from '../config/site';
import { useI18n } from '../i18n';

const { t, href } = useI18n(Astro);
---

<footer class="site-footer">
  <div class="container top">
    <div class="about">
      <img
        src="/assets/logo/kaviku-logo-mark-h128.png"
        alt=""
        width="173"
        height="128"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="studio">{siteConfig.name}</p>
        <p class="tagline">{t('footer.tagline')}</p>
      </div>
    </div>
    <nav class="links" aria-label={t('footer.navTitle')}>
      <a href={href('/#catalog')}>{t('header.nav.catalog')}</a>
      <a href={href('/#featured')}>{t('header.nav.featured')}</a>
    </nav>
  </div>

  <!-- Самый низ сайта: как в макете — студия слева, «Предложить игру» справа -->
  <div class="bottom">
    <div class="container bottom-inner">
      <div class="left">
        <p class="copy">{siteConfig.studioName}</p>
        <!-- Контакты: реклама и поддержка -->
        <p class="contacts">
          {t('footer.ads')} | {t('footer.support')}:{' '}
          <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        </p>
        <button class="rules-link" type="button" data-open-publication-rules aria-haspopup="dialog">
          {t('footer.publicationRules')}
        </button>
        <!-- Открытый исходный код (AGPL-3.0) на GitHub -->
        <a class="source-link" href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          {t('footer.openSource')}
        </a>
      </div>
      <SubmitGameButton />
    </div>
  </div>
  <PublicationRulesModal />
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem;
  }

  .about {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .about img {
    height: 40px;
    width: auto;
  }

  .studio {
    font-weight: 800;
    color: var(--brand);
  }

  .tagline {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .links a:hover {
    color: var(--brand);
  }

  .bottom {
    border-top: 1px solid var(--border);
    background: var(--surface-1);
  }

  .bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem calc(1.25rem + env(safe-area-inset-bottom));
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .copy {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .contacts {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    overflow-wrap: anywhere;
  }

  .contacts a {
    color: var(--brand);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-fast) var(--ease);
  }

  .contacts a:hover {
    text-decoration-color: currentColor;
  }

  .rules-link {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-faint);
    font-size: var(--fs-xs);
    font-family: inherit;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .rules-link:hover {
    color: var(--brand);
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    transition: color var(--t-fast) var(--ease);
  }

  .source-link :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .source-link:hover {
    color: var(--brand);
  }

  @media (max-width: 599px) {
    .rules-link,
    .source-link {
      align-self: center;
    }
  }

  @media (max-width: 599px) {
    .bottom-inner {
      flex-direction: column; /* кнопка «Предложить игру» — самый последний элемент страницы */
      align-items: stretch;
      text-align: center;
    }
  }
</style>
