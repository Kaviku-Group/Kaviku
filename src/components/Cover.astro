import { Image } from 'astro:assets';
import type { GameImage } from '../data/types';

/**
 * Обложка игры (16:9).
 * - Файл из папки games/ → оптимизируется при сборке (WebP, нужные размеры).
 * - Строка-URL (например, будущий R2) → обычный <img>.
 * - Нет обложки → нейтральная заглушка в цветах бренда с первой буквой названия.
 */
interface Props {
  title: string;
  cover?: GameImage;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { title, cover, sizes = '100vw', eager = false, class: className = '' } = Astro.props;
const initial = title.trim().charAt(0).toUpperCase();
---

<div class:list={['cover', className]}>
  {
    cover && typeof cover !== 'string' ? (
      <Image
        src={cover}
        alt={title}
        widths={[...new Set([...[480, 800, 1280, 1920].filter((w) => w < cover.width), Math.min(cover.width, 1920)])]}
        sizes={sizes}
        format="webp"
        quality={82}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : cover ? (
      <img src={cover} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <div class="placeholder" role="img" aria-label={title}>
        <span class="initial" aria-hidden="true">
          {initial}
        </span>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }

  .cover :global(img),
  .placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }

  .placeholder {
    display: grid;
    place-items: center;
    background-color: var(--surface-1);
  }

  .placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 148 24 / 0.32), transparent 55%),
      radial-gradient(90% 80% at 0% 100%, rgb(255 84 20 / 0.22), transparent 60%);
  }

  .placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background: repeating-linear-gradient(135deg, rgb(255 122 20 / 0.16) 0 2px, transparent 2px 18px);
  }

  .initial {
    position: relative;
    z-index: 1;
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 800;
    line-height: 1;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.9;
  }
</style>
