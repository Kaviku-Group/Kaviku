// Game page in English: /en/games/<slug>
import GameView from '../../../views/GameView.astro';
import { getPublishedGames } from '../../../data/catalog';
import type { GameSummary } from '../../../data/types';

export async function getStaticPaths() {
  const games = await getPublishedGames();
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: GameSummary };
---

<GameView game={game} />
