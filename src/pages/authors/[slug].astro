// Страница автора на русском: /authors/<slug>
import AuthorView from '../../views/AuthorView.astro';
import { getAuthors } from '../../data/catalog';
import type { GameSummary } from '../../data/types';

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.map((a) => ({ params: { slug: a.slug }, props: { nickname: a.nickname, games: a.games } }));
}

const { nickname, games } = Astro.props as { nickname: string; games: GameSummary[] };
---

<AuthorView nickname={nickname} games={games} />
